rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admins are users whose profile has role "admin" (set manually in the console).
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Product catalog: anyone can read, only admins can change it.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: created on first sign-in with role "user".
    // Nobody can change their own role from the app.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
  }
}
